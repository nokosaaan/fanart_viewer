# Example environment file for fanart_viewer
# Copy this to `.env` and fill in secrets before running `docker compose up`.

# PostgreSQL (optional override)
POSTGRES_DB=db
POSTGRES_USER=user
POSTGRES_PASSWORD=password

# Twitter API bearer token (required to enable reliable media fetching)
# Obtain from Twitter developer portal (Bearer token for OAuth2). Do NOT commit your real token.
TW_BEARER=your_twitter_bearer_token_here

# Optional: Nitter base if you want to use a custom Nitter instance
NITTER_BASE=https://nitter.net

# Pixiv (if used)
PIXIV_USER=
PIXIV_PASS=
HEADLESS_ALLOWED=1
