# Example environment file for fanart_viewer
# Copy this to `.env` and fill in secrets before running `docker compose up`.

# =============================================================================
# Django
# =============================================================================

# Secret key for signing cookies, CSRF tokens, etc.
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
# REQUIRED in production (DJANGO_DEBUG=0). Leaving it as "change-me" is insecure.
DJANGO_SECRET_KEY=change-me

# Comma-separated list of allowed hostnames (default: * = allow all).
# REQUIRED in production. Set to your Cloudflare Tunnel public hostname.
# Example: DJANGO_ALLOWED_HOSTS=yourname.example.com
DJANGO_ALLOWED_HOSTS=

# Set to 0 for production (disables debug toolbar, enables gunicorn via entrypoint.sh).
# Default: 1 (development)
DJANGO_DEBUG=1

# =============================================================================
# PostgreSQL
# =============================================================================

POSTGRES_DB=fanart
POSTGRES_USER=fanart
POSTGRES_PASSWORD=password

# Docker-internal DB host/port (set automatically by docker-compose; override only if needed).
DATABASE_HOST=db
DATABASE_PORT=5432

# =============================================================================
# Twitter / X
# =============================================================================

# Bearer token for Twitter v2 API (fast, accurate, but rate-limited).
# Obtain: https://developer.twitter.com → Project → "Bearer Token"
TW_BEARER=

# Which fetch method to try first.
# Options: api (default) | scrape | nitter
# Fallbacks are tried automatically on failure.
TW_FETCH_METHOD=api

# Nitter instance base URL (used when TW_FETCH_METHOD=nitter).
NITTER_BASE=https://nitter.net

# Authenticated X session cookies for fetching sensitive-content media.
# Obtain: DevTools → Application → Cookies → https://x.com
TWITTER_AUTH_TOKEN=
TWITTER_CT0=

# Set to 1 to log verbose Twitter API debug info to the backend console.
TW_API_DEBUG=0

# =============================================================================
# Pixiv
# =============================================================================

# Preferred: PHPSESSID cookie (no password stored in plaintext).
# Obtain: DevTools → Application → Cookies → https://www.pixiv.net → PHPSESSID
PIXIV_PHPSESSID=

# Alternative: username + password (used if PHPSESSID is not set).
PIXIV_USER=
PIXIV_PASS=

# =============================================================================
# Poipiku
# =============================================================================

# Long-lived login key. Required to view R15 / follower-only works.
# Obtain: DevTools → Application → Cookies → https://poipiku.com → POIPIKU_LK
POIPIKU_LK=

# Session ID (short-lived; POIPIKU_LK alone is usually enough).
# Obtain: same location → JSESSIONID
POIPIKU_JSESSIONID=

# =============================================================================
# Auth
# =============================================================================

# Leave both empty to disable authentication (local-only use).
# ADMIN_PASSWORD: owner — full read/write access (login via VITE_ADMIN_PATH)
# VIEWER_PASSWORD: shared password for guests — read-only access
ADMIN_PASSWORD=
VIEWER_PASSWORD=

# Secret for signing auth tokens. Defaults to DJANGO_SECRET_KEY if unset.
TOKEN_SECRET=

# Token lifetime in days. After this period the user must log in again (default: 30).
TOKEN_EXPIRY_DAYS=30

# Failed login attempts before an IP is blocked (default: 5).
LOGIN_MAX_ATTEMPTS=5

# Minutes to block an IP after too many failures (default: 15).
LOGIN_BLOCK_MINUTES=15

# Secret URL path for the admin login page.
# Admin login is available at: https://your-site.com/<VITE_ADMIN_PATH>
# The default login page (/) only accepts the viewer password.
# Generate with: python -c "import secrets; print(secrets.token_hex(8))"
VITE_ADMIN_PATH=

# =============================================================================
# Production (docker-compose.prod.yml)
# =============================================================================

# Path to the built React frontend inside the container (set by docker-compose.prod.yml).
# Only override if mounting the dist directory at a custom path.
# FRONTEND_DIST=/app/frontend_dist

# Number of gunicorn worker processes. Default: 2
# Recommended: (2 × CPU cores) + 1
# GUNICORN_WORKERS=2

# =============================================================================
# Cloudflare Tunnel (optional)
# =============================================================================

# Token for Cloudflare Named Tunnel.
# Obtain: Cloudflare Zero Trust dashboard → Networks → Tunnels → Create tunnel
#         → copy the token shown in the install command.
# When set, start with: docker compose --profile tunnel up -d
# Leave empty if not using Cloudflare Tunnel.
CLOUDFLARE_TUNNEL_TOKEN=

# =============================================================================
# Misc
# =============================================================================

# Allow headless browser operations (Playwright). Set to 0 to disable.
HEADLESS_ALLOWED=1
